        },
        "visualPriority": {
          "enum": [
            "signature",
            "supporting",
            "cameo",
            "ambient",
            "offscreen"
          ]
        },
        "identityNotes": {
          "type": "string"
        },
        "fixedTraits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "variants": {
          "type": "array",
