        },
        "placeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "overviewAssetId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
