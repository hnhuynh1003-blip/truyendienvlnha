              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            },
            "layer": {
              "type": "integer",
