{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dudu.studio/schemas/vangioi/world-content-1-draft.json",
  "title": "Vangioi incomplete authoring draft",
  "description": "Content only. Ownership, permissions, workflow and official rank are server-owned.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "world-content-1"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "$ref": "#/$defs/nonempty"
    },
    "genreId": {
      "enum": [
        "ancient",
        "modern",
        "era",
        "future",
        "cultivation",
        "apocalypse"
      ]
    },
    "dangerLevel": {
      "enum": [
        "low",
        "moderate",
        "high",
        "extreme"
      ]
    },
    "contentTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logline": {
          "$ref": "#/$defs/nonempty"
        },
        "setting": {
          "$ref": "#/$defs/nonempty"
        },
        "playerRole": {
          "$ref": "#/$defs/nonempty"
        },
        "opening": {
          "$ref": "#/$defs/nonempty"
        },
        "secretTruth": {
          "$ref": "#/$defs/nonempty"
        },
        "plotBeats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        },
        "worldRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "visualIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "landmarks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mood": {
          "type": "string"
        },
        "artStyle": {
          "type": "string"
        }
      }
    },
    "worldCoverAssetId": {
      "$ref": "#/$defs/id"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/map"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "characterVisuals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/characterVisual"
      }
    },
    "characterAppearances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/characterAppearance"
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/npc"
      }
    },
    "playerEntryProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/playerEntryProfile"
      }
    },
    "entryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "player_choice"
          ]
        },
        "forcedEntryId": {
          "$ref": "#/$defs/id"
        },
        "authorNote": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "shops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shop"
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mission"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "endings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ending"
      }
    },
    "playRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredVisitPlaceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "requiredInteractNpcIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrySceneId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "aiPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aiNpcRequested": {
          "type": "boolean"
        },
        "allowAiRewards": {
          "const": false
        },
        "allowAiWorldMutation": {
          "const": false
        },
        "reviewNotes": {
          "type": "string"
        }
      }
    },
    "requestedWorldRank": {
      "enum": [
        "F",
        "E",
        "D",
        "C",
        "B",
        "A",
        "S"
      ]
    },
    "storySource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "original",
            "library",
            "manuscript"
          ]
        },
        "storyId": {
          "type": "string",
          "maxLength": 160
        },
        "storyVersion": {
          "type": "string",
          "maxLength": 100
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "assetVersion": {
          "type": "string",
          "maxLength": 100
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "kind": {
          "enum": [
            "worldCover",
            "sceneBackground",
            "sceneVariant",
            "npcPortrait",
            "characterPortrait",
            "characterSprite",
            "characterIllustration",
            "characterSilhouette",
            "characterAvatar",
            "itemIcon",
            "other"
          ]
        },
        "altText": {
          "$ref": "#/$defs/nonempty"
        },
        "focalPoint": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "maxItems": 2
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapId": {
          "$ref": "#/$defs/id"
