  "story": {
    "logline": "Trước khi hồi chuông cuối vang lên, người lữ khách phải tìm ra chuyến đò thật giữa bến sương.",
    "setting": "Bến đò cổ bên sông. Sau canh ba, sương làm người ta nhầm lẫn tiếng chuông và bóng người.",
    "playerRole": "Một hành khách lạ có vé đò bị rách và chỉ biết mình phải sang bờ trước bình minh.",
    "opening": "Người chơi tỉnh dậy dưới mái quán ven bến; trên bàn là vé đò đã ướt và một lời dặn không hỏi tên khách đứng dưới sông.",
    "secretTruth": "Một chiếc đò là thật, chiếc còn lại chỉ là ảo ảnh của tiếng chuông bị vang ngược. Manh mối nằm ở phản chiếu và lời kể của người lái đò.",
    "plotBeats": [
      "Khám phá bến và nói chuyện với người bán nến.",
      "Nhận biết khách đứng dưới sông không có phản chiếu.",
      "Tìm người lái đò thật, giữ hoặc đổi vật dụng hỗ trợ.",
      "Lên thuyền đúng lúc hoặc bị sương đưa trở lại bến."
    ],
    "worldRules": [
      "Chuông vang lần thứ ba là hạn chót cho việc lên thuyền.",
      "Phản chiếu trên mặt nước có thể dùng làm manh mối; NPC được phép nói sai nhưng kết quả không đổi ngẫu nhiên.",
      "Sai lựa chọn tại bản thử nghiệm F dẫn đến thất bại có thể chơi lại, không xóa tài khoản."
    ]
  },
