// DUDU L2D.2 — BẢN RULES HỢP NHẤT ĐỂ CHỦ DỰ ÁN KIỂM DUYỆT.
// SOURCE: Rules hiện đang chạy do An Du cung cấp ngày 29/10/2026.
// NOT DEPLOYED. KHÔNG DÁN THẲNG KHI CHƯA SAO LƯU/KIỂM THỬ.
// Chỉ bổ sung hàm epubMetadataValidL2D2() và allow update L2D.2.
// Các quyền đọc, tạo bản thảo, xuất bản, chương, profile giữ nguyên.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Thư viện truyện dùng chung
    match /studio_data/main_library {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // 2. Hồ sơ tài khoản Firebase
    match /profiles_v2/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }

    // 3. Khóa hồ sơ cũ
    match /user_profiles/{username} {
      allow read, write: if false;
    }

    // 4. Quyền quản lý EPUB
    function epubIsAdminV49() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    function epubOwnerV49(storyId) {
      return epubIsAdminV49()
        && get(
          /databases/$(database)/documents/epub_stories_v49/$(storyId)
        ).data.ownerUid == request.auth.uid;
    }

    // L2D.2: kiểu dữ liệu, kích thước hợp lệ cho metadata sau phát hành.
    // get(default) để tương thích EPUB cũ có thể thiếu trường tùy chọn.
    function epubMetadataValidL2D2() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 140
        && request.resource.data.get('genre','') is string
        && request.resource.data.get('genre','').size() <= 220
        && request.resource.data.get('desc','') is string
        && request.resource.data.get('desc','').size() <= 3000
        && request.resource.data.get('publicationState','Đang ra') in ['Đang ra','Hoàn thành']
        && request.resource.data.get('coverImage','') is string
        && request.resource.data.get('coverImage','').size() < 32000
        && (request.resource.data.get('coverImage','') == '' ||
          request.resource.data.get('coverImage','').matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'))
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    // 5. Truyện EPUB V57
    match /epub_stories_v49/{storyId} {

      // Bản thảo: chỉ Admin được xem.
      // Độc giả: chỉ xem truyện đã xuất bản.
      allow get, list: if epubIsAdminV49()
        || resource.data.status == 'published';

      // Tạo bản nhập EPUB riêng tư
      allow create: if epubIsAdminV49()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'importing'
        && request.resource.data.chapterCount is int
        && request.resource.data.chapterCount >= 1
        && request.resource.data.chapterCount <= 160
        && request.resource.data.chapterIndex is list
        && request.resource.data.chapterIndex.size()
           == request.resource.data.chapterCount;

      // Chuyển trạng thái:
      // importing -> draft -> published
      allow update: if epubIsAdminV49()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.chapterCount == resource.data.chapterCount
        && request.resource.data.chapterIndex == resource.data.chapterIndex
        && (
          (
            resource.data.status == 'importing'
            && request.resource.data.status == 'draft'
          )
          ||
          (
            resource.data.status == 'draft'
            && request.resource.data.status == 'published'
          )
        );

      // L2D.2: quyền CHỈ chủ EPUB được sửa metadata hoặc gỡ/khôi phục.
      // Quy trình importing -> draft -> published ở trên được giữ nguyên.
      allow update: if epubIsAdminV49()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.chapterCount == resource.data.chapterCount
        && request.resource.data.chapterIndex == resource.data.chapterIndex
        && epubMetadataValidL2D2()
        && (
          // Chỉnh sửa thông tin, không đổi trạng thái công khai.
          (
            resource.data.status in ['published','archived']
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title','author','genre','desc','publicationState','coverImage','updatedAt'
            ])
          )
          ||
          // Gỡ công khai hoặc khôi phục, không xóa chương hay ID.
          (
            (
              (resource.data.status == 'published' && request.resource.data.status == 'archived')
              || (resource.data.status == 'archived' && request.resource.data.status == 'published')
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','updatedAt'
            ])
          )
        );

      // Không xóa truyện qua ứng dụng
      allow delete: if false;

      // 6. Nội dung từng chương EPUB
      match /chapters/{chapterId} {

        allow get, list: if epubIsAdminV49()
          || get(
            /databases/$(database)/documents/epub_stories_v49/$(storyId)
          ).data.status == 'published';

        // Chỉ Admin sở hữu sách được thêm chương
        allow create: if epubOwnerV49(storyId)
          && get(
            /databases/$(database)/documents/epub_stories_v49/$(storyId)
          ).data.status == 'importing'
          && request.resource.data.id == chapterId
          && request.resource.data.title is string
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 420000;

        // Không cho sửa hoặc xóa chương đã lưu
        allow update, delete: if false;
      }
    }

    // 7. Từ chối truy cập ngoài phạm vi cho phép
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
