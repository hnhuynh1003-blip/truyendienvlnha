// REVIEW ONLY — do not deploy over existing Storage rules without backing them up.
// Production EPub intake is deliberately private. Requires Firebase Auth admin=true
// server custom claim, and a correctly configured Cloud Storage for Firebase bucket.
rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /author_epub_drafts/{uid}/{fileId} {
   allow read: if request.auth != null &&
      request.auth.uid == uid && request.auth.token.admin == true;
   allow write: if request.auth != null &&
      request.auth.uid == uid && request.auth.token.admin == true &&
      request.resource != null &&
      request.resource.size > 0 &&
      request.resource.size <= 15 * 1024 * 1024 &&
      request.resource.contentType == 'application/epub+zip' &&
      fileId.matches('[0-9a-fA-F-]{36}\\.epub');
  }
  // This review file intentionally denies all other paths. Merge carefully
  // with approved existing rules; do not overwrite existing production rules.
  match /{path=**} { allow read, write: if false; }
 }
}
